graph G {
    graph [weighted="true"];

    "A" [value="Centro"];
    "B" [value="Biblioteca"];
    "C" [value="Laboratório"];
    "D" [value="Auditório"];
    "E" [value="Secretaria"];

    "A" -- "B" [label="4.0"];
    "A" -- "C" [label="2.5"];
    "B" -- "C" [label="1.5"];
    "B" -- "D" [label="3.0"];
    "C" -- "D" [label="6.0"];
    "C" -- "E" [label="5.0"];
    "D" -- "E" [label="2.0"];
}
